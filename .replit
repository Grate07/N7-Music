modules = ["nodejs-24", "python-base-3.13"]
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "N7 Music Bot"

[[workflows.workflow]]
name = "N7 Music Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DISCORD_TOKEN=\"$DISCORD_BOT_TOKEN\" PORT=10000 pnpm --filter @workspace/discord-bot run start"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 10000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["yt-dlp"]
